---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const statusLabel = {
	'in-progress': 'In progress',
	completed: 'Completed',
	archived: 'Archived',
};

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = (await getCollection('writing')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<p>
					[Bio paragraph — who you are, what you study, what kind of problems you like
					working on. Two or three sentences, written like you'd say it out loud.]
				</p>
				<p class="currently">
					<strong>Currently:</strong> [one line about what you're working on or studying
					right now].
				</p>
			</section>

			<section>
				<h2>Things I've built</h2>
				<ul class="entry-list">
					{
						projects.map((project) => (
							<li>
								<a href={`/projects/${project.id}/`}>
									<span class="entry-title">{project.data.title}</span>
									<span class="entry-meta">
										{project.data.stack.join(', ')}
										{project.data.stack.length > 0 && ' · '}
										{statusLabel[project.data.status]}
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section>
				<h2>Writing</h2>
				<ul class="entry-list">
					{
						posts.map((post) => (
							<li>
								<a href={`/writing/${post.id}/`}>
									<span class="entry-title">{post.data.title}</span>
									<span class="entry-date"><FormattedDate date={post.data.pubDate} /></span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
