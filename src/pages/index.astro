---
import BaseHead from '../components/BaseHead.astro';
import EntryList from '../components/EntryList.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { projectMeta, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

// The full lists live at /projects and /writing; the homepage shows the latest few.
const projects = (await getCollection('projects'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
const posts = (await getCollection('writing'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<p>
					[Bio paragraph — who you are, what you study, what kind of problems you like
					working on. Two or three sentences, written like you'd say it out loud.]
				</p>
				<p class="currently">
					<strong>Currently:</strong> [one line about what you're working on or studying
					right now].
				</p>
			</section>

			<section>
				<h2>Things I've built</h2>
				<EntryList
					entries={projects.map((project) => ({
						href: `/projects/${project.id}/`,
						title: project.data.title,
						meta: projectMeta(project.data.stack, project.data.status),
					}))}
				/>
			</section>

			<section>
				<h2>Writing</h2>
				<EntryList
					entries={posts.map((post) => ({
						href: `/writing/${post.id}/`,
						title: post.data.title,
						date: post.data.pubDate,
					}))}
				/>
			</section>
		</main>
		<Footer />
	</body>
</html>
